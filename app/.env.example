# ═══════════════════════════════════════════════════════════════════
# SHUTTER - B2B Retail Platform Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ── Application ──────────────────────────────────────────────────────
NODE_ENV=development
APP_ID=shutter-app                    # Application identifier
APP_SECRET=                           # JWT signing secret (MIN 32 chars, use: openssl rand -base64 32)
PORT=3000                             # Server port

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=                         # MySQL connection string (mysql://user:pass@host:port/database)

# ── Authentication - Google OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=                     # Google OAuth Client ID (from Google Cloud Console)

# ── Authentication - Kimi OAuth ───────────────────────────────────────
KIMI_AUTH_URL=                        # Kimi OAuth server URL
KIMI_OPEN_URL=                        # Kimi Open Platform URL
VITE_KIMI_AUTH_URL=                   # Kimi OAuth URL (frontend)
VITE_APP_ID=                          # OAuth application ID

# ── Authentication - Supabase ─────────────────────────────────────────
VITE_SUPABASE_URL=                    # Supabase Project URL (https://xxx.supabase.co)
VITE_SUPABASE_ANON_KEY=               # Supabase Anon/Publishable Key (public, starts with eyJ...)
SUPABASE_SERVICE_ROLE_KEY=            # Supabase Service Role Key (SECRET, backend only)

# ── AI Assistant - Google Gemini ──────────────────────────────────────
GEMINI_API_KEY=                       # Gemini API Key from Google AI Studio (starts with AIza)

# ── Admin Configuration ──────────────────────────────────────────────
OWNER_UNION_ID=                       # Union ID of the app creator (gets admin role on first login)

# ── Security ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173  # Comma-separated CORS origins

# ── Optional - Monitoring & Analytics ─────────────────────────────────
# SENTRY_DSN=                         # Sentry error tracking DSN
# LOG_LEVEL=info                      # Logging level (debug, info, warn, error)

# ═══════════════════════════════════════════════════════════════════
# REQUIRED FOR PRODUCTION:
# - APP_SECRET (32+ characters)
# - DATABASE_URL
# - GOOGLE_CLIENT_ID
# - VITE_SUPABASE_URL
# - VITE_SUPABASE_ANON_KEY
# - GEMINI_API_KEY
# ═══════════════════════════════════════════════════════════════════
